# Documentation-only template. Demo code does not read this file.
# Names and callback paths are illustrative, not verified production settings.
# Configure real redirect URIs to match your implemented OAuth handler.
# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8501
APP_TIMEZONE=America/New_York
DEMO_MODE=true

# WHOOP API — placeholders only
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_REDIRECT_URI=http://localhost:8501/oauth/callback
WHOOP_ACCESS_TOKEN=your_short_lived_access_token
WHOOP_REFRESH_TOKEN=your_refresh_token

# Supabase — placeholders only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key

# Google OAuth — placeholders only
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
